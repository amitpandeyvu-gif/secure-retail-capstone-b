{
  "info": {
    "_postman_id": "1d80cd87-961a-4d23-bf9c-d96c5843df1f",
    "name": "Pop Culture Sprint 3 Backend",
    "description": "Week 7 checks for the Express server and SQLite-backed API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Server Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Server is running', () => pm.expect(pm.response.text()).to.include('Server Running'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Products are returned', () => {",
              "  const products = pm.response.json();",
              "  pm.expect(products).to.be.an('array').that.is.not.empty;",
              "  pm.expect(products[0]).to.have.property('name');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Categories are returned', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    }
  ]
}
