# Optional process environment settings. Defaults are suitable for local work.
HOST=127.0.0.1
PORT=3000
# DATABASE_PATH=data/retail.db
# Change these values before sharing or deploying the administration portal.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123
# Required for stable signed administrator sessions on a hosted deployment.
# ADMIN_SESSION_SECRET=replace-with-a-long-random-value
# CUSTOMER_SESSION_SECRET=replace-with-a-different-long-random-value
# GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# RESEND_API_KEY=re_your_server_side_api_key
# EMAIL_FROM=Pop Culture Clothing <login@your-verified-domain.example>
# EMAIL_REPLY_TO=support@your-verified-domain.example
PUBLIC_APP_URL=https://pop-culture-clothing-capstone.vercel.app
# Vercel's Upstash integration supplies these for durable hosted orders.
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your-server-side-token
# ALLOW_DEMO_LOGIN=0
